# Dashboard environment (Vercel)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_SCHEMA=cdr

# Runner environment
CDR_MODE=mock
CDR_ARTIFACTS_DIR=

# IBM Bob Shell (runtime repository-aware diagnosis)
BOB_API_KEY=
CDR_ANALYZER=auto
CDR_BOB_MAX_COST=2
CDR_BOB_TIMEOUT_S=420
CDR_CLONE_REPOS=1

# IBM watsonx.ai (Granite models only)
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Supabase sync (service role, runner only — never expose to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=cdr

# Generated PR target
CDR_GITHUB_REPO=
GITHUB_TOKEN=
